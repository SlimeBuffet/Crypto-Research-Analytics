# =============================================================================
# Crypto Scanner Engine - Environment Variables
# =============================================================================
# Copy this file to .env and fill in your API keys.
# IMPORTANT: Never commit .env to the repository — it is already in .gitignore.
# Multiple keys per service enable rotation for higher throughput.
# =============================================================================

# --- Binance API (public, no key required for market data) ---
# Primary: data-api.binance.vision (works globally, no geo-restriction)
# Fallback: api.binance.com (may return 451 in restricted regions)
BINANCE_BASE_URL=https://data-api.binance.vision/api/v3

# --- DexScreener API (public, no key required) ---
# Endpoint: https://api.dexscreener.com/latest/dex/tokens/{address}
DEXSCREENER_BASE_URL=https://api.dexscreener.com/latest

# --- CoinCap API (public, fallback to CoinGecko if unavailable) ---
# Primary: api.coincap.io (may have DNS issues in some regions)
# Fallback: CoinGecko free API (automatic, no key required)
COINCAP_BASE_URL=https://api.coincap.io/v2

# --- Alchemy RPC (supports multiple keys for rotation) ---
# Single key works across all chains. The engine builds the full URL per chain:
#   BNB:        https://bnb-mainnet.g.alchemy.com/v2/<key>
#   Solana:     https://solana-mainnet.g.alchemy.com/v2/<key>
#   Worldchain: https://worldchain-mainnet.g.alchemy.com/v2/<key>
#   Ethereum:   https://eth-mainnet.g.alchemy.com/v2/<key>
ALCHEMY_KEY_1=your_alchemy_key_1

# --- QuickNode RPC (chain-specific full URLs, supports multiple keys) ---
# BSC HTTP endpoint
QUICKNODE_HTTP_BSC_1=https://your-bsc-endpoint.quiknode.pro/your_key/
# BSC WebSocket endpoint (for real-time streaming)
QUICKNODE_WSS_1=wss://your-bsc-endpoint.quiknode.pro/your_key/

# --- CryptoRank API ---
# Base URL: https://api.cryptorank.io/v1
CRYPTORANK_API_KEY_1=your_cryptorank_key_1

# --- Mobula API ---
# Base URL: https://api.mobula.io/api/1
# Key is sent via Authorization header
MOBULA_API_KEY_1=your_mobula_key_1

# --- Scanner Configuration ---
# Max concurrent API requests
CONCURRENCY_LIMIT=5
# Cache TTL in seconds (6 hours default)
CACHE_TTL_SECONDS=21600
# Minimum 24h volume (USD) to pass discovery filter
MIN_VOLUME_USD=500000
# Market cap range for 10x potential
MIN_MARKET_CAP_USD=10000000
MAX_MARKET_CAP_USD=500000000
# Max FDV/MC ratio
MAX_FDV_MC_RATIO=2.5

# --- LunarCrush API (social sentiment, Galaxy Score) ---
# Requires Individual or higher subscription
# Base URL: https://lunarcrush.com/api4
LUNARCRUSH_API_KEY=your_lunarcrush_api_key

# --- FRED API (for DXY & Fed Rates — Pillar D Macro) ---
FRED_API_KEY=your_fred_api_key

# =============================================================================
# Hedge Fund Intelligence & Execution Engine — Configuration
# =============================================================================

# --- Technical Trigger (SMA Price Channel) ---
TRIGGER_HIGH_PERIOD=8
TRIGGER_LOW_PERIOD=8
TRIGGER_SMA_PERIOD=5
TRIGGER_OFFSET=0

# --- Risk Engine (Pillar B) ---
MAX_CORRELATION=0.8

# --- Execution Engine (Pillar C) ---
MAX_SLIPPAGE_PCT=1.0
POSITION_SIZE_USD=100000
MAX_OPEN_POSITIONS=10
EXECUTION_TYPE=VWAP
EXECUTION_SLICES=10
EXECUTION_INTERVAL_MS=60000

# --- Macro Overlay (Pillar D) ---
MACRO_ENABLED=true

# --- Real-time Alerts (Module 5) ---
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id
DISCORD_WEBHOOK_URL=your_discord_webhook_url

# --- Narrative Engine (Module 6) ---
GITHUB_TOKEN=your_github_token

# =============================================================================
# Master Scanner Engine — Configuration
# =============================================================================

# --- Stream Ingestor (Layer 1) ---
# Helius RPC for Solana graduated token detection (optional)
HELIUS_RPC_URL=

# --- Master Feature Toggles ---
MASTER_ENABLE_SMC=true
MASTER_ENABLE_FORENSICS=true
MASTER_ENABLE_NARRATIVE=true
MASTER_ENABLE_ANTI_MANIPULATION=true
MASTER_ENABLE_AUTO_OPTIMIZATION=true
MASTER_ENABLE_AGENTIC=true

# --- SMC Timeframes ---
MASTER_SMC_TIMEFRAMES=1h,4h,1d

# --- Logging ---
LOG_LEVEL=info
