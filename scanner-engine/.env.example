# =============================================================================
# Crypto Scanner Engine - Environment Variables
# =============================================================================
# Copy this file to .env and fill in your API keys.
# Multiple keys per service enable rotation for higher throughput.
# =============================================================================

# --- Binance API (public, no key required for market data) ---
BINANCE_BASE_URL=https://data-api.binance.vision/api/v3

# --- DexScreener API (public, no key required) ---
DEXSCREENER_BASE_URL=https://api.dexscreener.com/latest

# --- Alchemy RPC (supports multiple keys for rotation) ---
ALCHEMY_KEY_1=your_alchemy_key_1
ALCHEMY_KEY_2=your_alchemy_key_2
ALCHEMY_KEY_3=your_alchemy_key_3

# --- QuickNode RPC (chain-specific, supports multiple keys for rotation) ---
# BSC endpoints
QUICKNODE_HTTP_BSC_1=https://your-bsc-quicknode.quiknode.pro/your_key/
# Ethereum endpoints
QUICKNODE_HTTP_ETH_1=https://your-eth-quicknode.quiknode.pro/your_key/
# World Chain endpoints
QUICKNODE_HTTP_WORLDCHAIN_1=https://your-worldchain-quicknode.quiknode.pro/your_key/
# WebSocket (for real-time streaming)
QUICKNODE_WSS_1=wss://your-quicknode-endpoint.quiknode.pro/your_key/

# --- CryptoRank API ---
CRYPTORANK_API_KEY_1=your_cryptorank_key_1
CRYPTORANK_API_KEY_2=your_cryptorank_key_2

# --- Mobula API ---
MOBULA_API_KEY_1=your_mobula_key_1
MOBULA_API_KEY_2=your_mobula_key_2

# --- CoinCap API (fallback, public tier available) ---
COINCAP_API_KEY_1=your_coincap_key_1
COINCAP_API_KEY_2=your_coincap_key_2

# --- Scanner Configuration ---
# Max concurrent API requests
CONCURRENCY_LIMIT=5
# Cache TTL in seconds (6 hours default)
CACHE_TTL_SECONDS=21600
# Minimum 24h volume (USD) to pass discovery filter
MIN_VOLUME_USD=500000
# Market cap range for 10x potential
MIN_MARKET_CAP_USD=10000000
MAX_MARKET_CAP_USD=500000000
# Max FDV/MC ratio
MAX_FDV_MC_RATIO=2.5

# =============================================================================
# Hedge Fund Intelligence & Execution Engine
# =============================================================================

# --- Engine Mode ---
# "scanner" = Core Scanner only, "hedge-fund" = Full Hedge Fund pipeline
ENGINE_MODE=scanner

# --- Trigger Unit (SMA Price Channel) ---
SMA_HIGH_PERIOD=8
SMA_LOW_PERIOD=8
SMA_SMOOTH_PERIOD=5

# --- Pillar B: Risk Engine ---
# Max correlation between portfolio holdings (higher = more overlap allowed)
CORRELATION_THRESHOLD=0.8
# VaR confidence level (0.95 = 95%, 0.99 = 99%)
VAR_CONFIDENCE=0.95

# --- Pillar C: Execution ---
# Max acceptable slippage for trade execution
MAX_SLIPPAGE_PCT=1.0
# Max position size as % of portfolio
MAX_POSITION_SIZE_PCT=5.0

# --- Pillar D: Macro Overlay ---
# DXY breakout detection sensitivity (standard deviations)
DXY_BREAKOUT_THRESHOLD=2.0
# Fed rate data (manually updated or from API)
FED_RATE_CURRENT=5.25
FED_RATE_PREVIOUS=5.25

# --- Logging ---
LOG_LEVEL=info
