{
  "name": "crypto-scanner-engine",
  "version": "1.0.0",
  "description": "High-Performance Crypto Scanner Engine with Multi-API Integration and Key Rotation",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "hedge-fund": "node dist/hedge-fund-runner.js",
    "hedge-fund:dev": "ts-node src/hedge-fund-runner.ts",
    "master": "node dist/master-runner.js",
    "master:dev": "ts-node src/master-runner.ts",
    "lint": "eslint src/ --ext .ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "crypto",
    "scanner",
    "binance",
    "dexscreener",
    "typescript"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20.11.0",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^6.19.0",
    "@typescript-eslint/parser": "^6.19.0",
    "eslint": "^8.56.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3",
    "vitest": "^4.1.5"
  },
  "dependencies": {
    "axios": "^1.6.5",
    "better-sqlite3": "^12.9.0",
    "dotenv": "^16.3.1",
    "drizzle-orm": "^0.45.2",
    "ethers": "^6.10.0",
    "p-limit": "^3.1.0",
    "pino": "^8.17.2",
    "pino-pretty": "^10.3.1",
    "piscina": "^5.1.4",
    "ws": "^8.20.0"
  }
}
